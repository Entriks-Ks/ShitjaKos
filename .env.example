# Local defaults; setup:local creates a random secret without overwriting .env.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# For Supabase, set DATABASE_URL to its transaction pooler (port 6543) and
# DIRECT_URL to its session pooler (port 5432). Prisma migrations use DIRECT_URL.
# DIRECT_URL="postgresql://postgres.<project-ref>:<encoded-password>@<pooler-host>:5432/postgres"
BETTER_AUTH_URL="http://localhost:3001"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
# File delivery only works during local development.
MAIL_MODE="file"
# Production SMTP configuration:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_FROM="ShitjaKos <no-reply@example.com>"
